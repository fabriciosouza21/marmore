meta {
  name: editar_imagem
  type: http
}

method {
  name: multipartForm
  sequence: 1
}

# Editar imagem: recebe prompt + 1+ imagens em multipart.
# Devolve PNG (image/png) ou erro 4xx/5xx com a mensagem.
# Substitua {{baseUrl}} e os caminhos das imagens no seu ambiente.
post {
  url: {{baseUrl}}/images/edit
  body: multipartForm
}

# Caminho das imagens de entrada, relativo a este arquivo .bru.
# Os arquivos de exemplo acompanham a collection em ../assets/.
body:multipartForm {
  prompt: bancada suspensa em granito verde, com cuba embutida e escorredor rebaixado
  images: file(../assets/ambiente.jpg)
  images: file(../assets/granito.png)
}

headers {
  Accept: image/png
}

tests {
  // Sucesso: PNG volta com 200 e content-type correto
  test("status 200 em sucesso", function() {
    expect(res.getStatus()).to.eql(200);
  });

  test("content-type image/png", function() {
    expect(res.getHeader("Content-Type")).to.include("image/png");
  });

  // Erros esperados conforme contrato:
  // 400 = imagem de entrada ausente
  // 503 = OPENAI_API_KEY ausente no servidor
  // 502 = falha ao chamar a OpenAI
  test("nao devolver 5xx inesperado", function() {
    const status = res.getStatus();
    if (status >= 500 && status !== 502 && status !== 503) {
      assert.fail("status " + status + " nao esperado");
    }
  });
}

docs {
  # POST /images/edit

  Edita imagens a partir de um prompt + imagens de referencia.

  **Entrada:** multipart/form-data
  - `prompt` (texto): instrucao de edicao
  - `images` (arquivo, 1+): imagens base e de material

  **Saida em sucesso:** `200 OK` com `Content-Type: image/png` e o binario do PNG.

  **Saida em erro:**
  | Status | Quando |
  | --- | --- |
  | 400 | imagem de entrada ausente ou invalida |
  | 503 | api-key da OpenAI nao configurada no servidor |
  | 502 | falha ao chamar a OpenAI (modelo, timeout, rate limit) |

  A chave da OpenAI lê de `OPENAI_API_KEY` via Spring AI.
  Configure no ambiente do Bruno (`baseUrl`) o endereco do servidor:
  - Local: `http://localhost:8080`
}
