# Template de variaveis de ambiente. Copie para .env e preencha.
# O .env nao vai para o git; o docker compose e o load-env.sh o leem.

# Chave da API OpenAI. Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Chave de acesso a esta API (header X-API-Key). Local: gere uma propria.
MARMORE_API_KEY=

# Postgres local (docker compose)
POSTGRES_DB=marmore
POSTGRES_USER=marmore
POSTGRES_PASSWORD=

# MinIO local (docker compose)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=marmore
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=marmore-imagens-geradas
